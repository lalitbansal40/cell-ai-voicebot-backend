# Cell AI Voicebot — backend environment variables
# Copy to `.env` for local development. `.env` is gitignored — NEVER commit real values.
# Lines marked "SECRET" must only ever hold real values in `.env` / server env / password manager.

# ── App (used from Phase 1)
NODE_ENV=development
PORT=5100
# Listen address: empty = every interface, IPv4 + IPv6 (default); 127.0.0.1 behind nginx with host networking (Phase 13)
HOST=
# Build info for GET /health — set by the image build (Phase 13), not by hand
GIT_SHA=
BUILT_AT=
# Public auth routes: requests per 15 min per IP and route (default 30; the E2E suite raises it)
AUTH_RATE_LIMIT_MAX=30
APP_URL=http://localhost:5100
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
LOG_LEVEL=debug
# false | true | <hop count> | loopback — set when running behind nginx / a load balancer (Phase 12)
TRUST_PROXY=false
# Swagger UI at /api/docs — empty = on outside production, off in production (Phase 1 — T1.14)
API_DOCS_ENABLED=
# true when nginx sends Strict-Transport-Security (the API then leaves it out)
HSTS_BY_PROXY=false
# Phase 17: the site certificate, read for its expiry date on Admin → System (production only)
TLS_CERT_PATH=
# true: big superadmin actions need a fresh two-step code. Turn on after setting it up.
MFA_ENFORCED_FOR_ADMINS=false

# ── Data (used from Phase 1) — local Docker infra, see `npm run infra:up`
MONGODB_URI=mongodb://127.0.0.1:27018/cell_ai_voicebot?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6380
# Run BullMQ workers in this process (Phase 12 may run them in a separate worker process)
WORKERS_ENABLED=true

# ── Auth & security (used from Phase 2)
# SECRET — kabhi commit nahi
JWT_ACCESS_SECRET=change-me
# SECRET — kabhi commit nahi
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# SECRET — kabhi commit nahi (32 random bytes, base64 — used to encrypt PII at rest)
ENCRYPTION_KEY=
# During a key rotation: previous keys, comma separated (docs/ops/secret-rotation.md)
ENCRYPTION_KEYS_OLD=
# Base64 of 32+ bytes. Never rotate. Required in production for contact erasure.
SUPPRESSION_HMAC_KEY=
# Refresh-cookie domain, e.g. .example.com when API and app are on subdomains; empty = host-only (Phase 2)
AUTH_COOKIE_DOMAIN=
# DEV ONLY — password for `npm run db:seed` demo users; empty = random password printed once (Phase 2)
SEED_PASSWORD=change-me-32-bytes-base64

# ── AI (used from Phase 5 / 7)
# SECRET — kabhi commit nahi
OPENAI_API_KEY=
# Realtime voice model (default gpt-realtime-2.1-mini)
OPENAI_REALTIME_MODEL=
# fake = deterministic test AI (dev / tests / E2E); openai = real (default when OPENAI_API_KEY is set; required in production)
AI_PROVIDER=
# OpenAI API base URL (tests point it at a local stub)
OPENAI_BASE_URL=
# Default text model for agents (default gpt-4.1-mini)
OPENAI_TEXT_MODEL=
# Embedding model for knowledge bases (default text-embedding-3-small, 1536 dims)
OPENAI_EMBEDDING_MODEL=
# Comma list of text models agents may choose (must include OPENAI_TEXT_MODEL; default = that model)
AI_TEXT_MODELS=
# Let agent functions / knowledge URLs reach private hosts like localhost (default true outside production; must be false in production)
AI_FUNCTIONS_ALLOW_PRIVATE_HOSTS=
# DEV ONLY — mock client APIs such as /api/v1/mock/payment-status (default true outside production; must be false in production)
MOCK_APIS_ENABLED=

# ── Voice calls (Phase 7)
# fake = deterministic voice (dev / tests / E2E); openai = Realtime / TTS / transcription (default = AI_PROVIDER; required in production)
VOICE_PROVIDER=
# realtime (speech-to-speech, default) or chat (speech-to-text → chat model → text-to-speech)
VOICE_PIPELINE=
# DEV / TEST ONLY — typed customer text on web calls (default true outside production; must be false in production)
VOICE_TEXT_INPUT_ENABLED=
# Text-to-speech model for speak steps (default gpt-4o-mini-tts)
OPENAI_TTS_MODEL=
# Speech-to-text model for listen steps (default gpt-4o-mini-transcribe)
OPENAI_TRANSCRIBE_MODEL=
# Days calls, transcripts and recordings are kept (default 180)
CALL_RETENTION_DAYS=
# Folder for recordings being written during a call (default <os tmp>/cav-rec)
CALL_RECORDING_TMP_DIR=

# --- Campaigns (Phase 8) ---
# Phone line for campaigns and single calls: dryrun (simulated, default) or sip (Phase 18; accounts opt in)
TELEPHONY_PROVIDER=
# Fastest dry-run speed, virtual time ×N (default 50; production 20, at most 20)
DRY_RUN_MAX_SPEED=
# false stops campaign dispatching (maintenance); default true
CAMPAIGNS_ENABLED=

# ── WhatsApp / Meta (Phase 9) — real values at Meta setup time: docs/setup/meta-whatsapp.md
# WHATSAPP_ENABLED: default true outside production; in production on when META_APP_ID is set
WHATSAPP_ENABLED=
# META_PROVIDER: fake (simulated Meta — dev / tests / E2E) | meta (production)
META_PROVIDER=
META_APP_ID=
# App secret (min 32 chars) — signs webhooks and the data deletion requests
META_APP_SECRET=
# Embedded Signup: Facebook Login for Business configuration id
META_ES_CONFIG_ID=
# Webhook verify token you type into the Meta app (min 24 chars)
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# Only tests point this at a local stub; production must keep the default
META_GRAPH_BASE_URL=https://graph.facebook.com
# Platform pays Meta: our Solution Partner credit line id + System User token
META_CREDIT_LINE_ID=
META_SYSTEM_USER_TOKEN=
# DEV / TEST ONLY — secret of the fake Meta provider (default dev-fake-meta-app-secret); never in production
FAKE_META_APP_SECRET=

# ── Managed WhatsApp numbers over the Pinnacle partner API (PN)
# 6-digit two-step verification PIN used to register numbers on connect / "Register number"
# (unset = a random PIN per number). Keep it secret.
WHATSAPP_REGISTER_PIN=
# true = superadmins can add numbers that live at Pinnacle (needs WHATSAPP_ENABLED)
PINNACLE_ENABLED=
# Partner API host (default https://partnersv1.pinbot.ai) and its WhatsApp Voice host (default = base)
PINNACLE_BASE_URL=
PINNACLE_VOICE_BASE_URL=
# Request timeout in ms (2000–60000, default 15000)
PINNACLE_TIMEOUT_MS=

# ── WhatsApp inbox (Phase 10)
# Days messages + media are kept (0 = keep forever, else at least 30; default 90)
INBOX_RETENTION_DAYS=
# DEV / E2E ONLY — fake Meta status webhooks after sent,delivered,read ms (or off); default 500,1500,3000 in development, off in tests; never in production
FAKE_META_STATUS_DELAYS_MS=

# ── WhatsApp templates + billing (Phase 11)
# DEV / E2E ONLY — fake Meta reviews a submitted template after this many ms (or off); default 3000 in development, off in tests; never in production
FAKE_META_TEMPLATE_REVIEW_MS=

# ── WhatsApp calling (Phase 12)
# Call media (WebRTC) in this process: true | false (default: on when WhatsApp is on)
WA_MEDIA_ENABLED=
# Public IPv4 of this server (1:1 NAT), added as a host candidate — required with META_PROVIDER=meta
WA_MEDIA_PUBLIC_IP=
# UDP port range for call media (default 40000–40999, at least 100 ports; open it in the firewall)
WA_MEDIA_PORT_MIN=
WA_MEDIA_PORT_MAX=
# Comma list of stun:host:port, or off (default stun:stun.l.google.com:19302; none in tests)
WA_STUN_URLS=
# WhatsApp calls with media per process (default 50)
WA_MEDIA_MAX_CALLS=
# DEV / E2E ONLY — fake Meta call timings connect,ringing,accepted ms (or off = immediate); default 100,200,800 in development, off in tests; never in production
FAKE_META_CALL_DELAYS_MS=
# DEV / E2E ONLY: fake Meta calls skip the calling window (never with the real Meta / in production)
WA_CALL_WINDOW_IGNORED=

# ── Storage (used from Phase 7 / 9) — STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
# SECRET — kabhi commit nahi
AWS_ACCESS_KEY_ID=
# SECRET — kabhi commit nahi
AWS_SECRET_ACCESS_KEY=

# ── Email (Phase 1 — T1.13; ADR 0030)
# smtp | log — default: smtp when SMTP_HOST is set, else log (emails are only logged).
# Production requires smtp. Local dev: Mailpit from `npm run infra:up` → SMTP_HOST=127.0.0.1, SMTP_PORT=1025
EMAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); empty = auto (true only when SMTP_PORT=465)
SMTP_SECURE=
# SMTP_USER and SMTP_PASS must be set together (or both empty)
SMTP_USER=
# SECRET — kabhi commit nahi
SMTP_PASS=
MAIL_FROM="Cell AI Voicebot <no-reply@example.com>"

# ── Payments & billing (Phase 4)
# fake = local test payments (dev / tests / E2E); production requires razorpay
PAYMENT_PROVIDER=
# Dev-only secret of the fake provider (never set in production)
FAKE_PAYMENT_SECRET=
# Seller on GST invoices (required in production)
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
# GST state code of the seller, e.g. 08 = Rajasthan (default 08 outside production)
BILLING_SELLER_STATE_CODE=
# SAC on invoices (default 998319 — confirm with the CA)
BILLING_SAC_CODE=
# Invoice number prefix, 1–3 capital letters (default CAV → CAV/26-27/000001)
BILLING_INVOICE_PREFIX=
# Superadmin billing simulator (default true outside production, false in production)
BILLING_SIMULATOR_ENABLED=
RAZORPAY_KEY_ID=
# SECRET — kabhi commit nahi
RAZORPAY_KEY_SECRET=
# SECRET — kabhi commit nahi
RAZORPAY_WEBHOOK_SECRET=

# ── Telephony: SIP line (Phase 18, ADR 0050) — docs/integrations/sip-trunk.md
# SECRET — kabhi commit nahi
NOTIFYNOW_API_KEY=
# Asterisk REST Interface (loopback); the trunk login itself is in the asterisk container's env
ARI_URL=
ARI_USER=
# SECRET — kabhi commit nahi; required with TELEPHONY_PROVIDER=sip (at least 24 characters)
ARI_PASSWORD=
ARI_APP=
# PJSIP endpoint name of the trunk (default trunk)
SIP_TRUNK_ENDPOINT=
# Caller ID when the account / campaign has no number (E.164, e.g. +911600000000); required in production with sip
SIP_CALLER_ID=
# ulaw (default) or alaw — must match the trunk
SIP_CODEC=
# Trunk channels at once across all processes (default 30) and new calls per second (default 2)
SIP_MAX_CHANNELS=
SIP_MAX_CPS=
# Seconds a phone may ring (default 40); seconds without audio before a call ends (default 10)
SIP_RING_TIMEOUT_SEC=
SIP_MEDIA_TIMEOUT_SEC=
# Our RTP ports for Asterisk ExternalMedia (default 21000-21999, loopback)
SIP_APP_RTP_PORTS=
# Address Asterisk sends our RTP to / we send Asterisk's to (default 127.0.0.1; the Mac lab differs)
SIP_APP_RTP_ADVERTISE=
SIP_ASTERISK_RTP_HOST=
# Trunk cost per minute in paise, for the margin report (optional)
SIP_TRUNK_COST_PAISE_PER_MIN=
# New SIP minutes per account per hour before its campaigns pause (toll-fraud guard, default 600)
SIP_SPEND_MINUTES_PER_HOUR=
# Incoming trunk calls (Phase 20, docs/integrations/sip-inbound.md): true only with TELEPHONY_PROVIDER=sip
SIP_INBOUND_ENABLED=
# Calls per caller number per hour before "busy" (default 10); trunk channels kept for incoming calls (default 0)
SIP_INBOUND_PER_CALLER_PER_HOUR=
SIP_INBOUND_RESERVED_CHANNELS=
# Longest ring time an account may choose for its team (default 120 seconds)
SIP_INBOUND_RING_MAX_SEC=

# ── Recorded-voice / IVR campaigns (Cell24x7 Voice API, docs/integrations/cell24x7-voice.md)
# Account API keys work without any of these settings; public defaults: src/config/voice-api.ts.
# Optional shared platform login: off (default) | fake (dev / tests) | cell24x7
VOICE_API_PROVIDER=
# Partner API base URL (default https://voice.truebeeps.com/api/v1/voice/partner)
CELL24X7_VOICE_BASE_URL=
# Optional shared-platform secret; account keys are entered in the dashboard, encrypted in MongoDB.
CELL24X7_VOICE_API_TOKEN=
# Caller ID sent with every submit (10 digits; 9999999999 until Cell24x7 gives one)
CELL24X7_VOICE_CALLER_ID=
# Shared-platform webhook secret (min 32 chars); account webhook secrets are generated automatically.
CELL24X7_WEBHOOK_SECRET=
# Numbers per Cell24x7 submit (default 200), gateway lines for the ETA (default 4)
VOICE_API_BATCH_SIZE=
VOICE_API_LINES=
# Seconds between result polls of open batches (default 120)
VOICE_API_POLL_SEC=
# Fake provider: ms before a fake number gets its result (default 2000)
VOICE_API_FAKE_DELAY_MS=

# ── Tooling (scripts only, not the API)
# Absolute path to the client server SSH key used by `npm run server:audit` (path only — the key itself stays outside the repo)
CLIENT_SSH_KEY_PATH=

# Phase 19: optional lower ceiling; channel caps remain Business App 18 / Cloud API 75 msg/sec.
WA_CAMPAIGN_MPS=
# Phase 19: largest WhatsApp campaign audience (1–100000).
WA_CAMPAIGN_MAX_RECIPIENTS=100000
