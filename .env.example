# Cell AI Voicebot — backend environment variables
# Copy to `.env` for local development. `.env` is gitignored — NEVER commit real values.
# Lines marked "SECRET" must only ever hold real values in `.env` / server env / password manager.

# ── App (used from Phase 1)
NODE_ENV=development
PORT=5100
APP_URL=http://localhost:5100
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
LOG_LEVEL=debug
# false | true | <hop count> | loopback — set when running behind nginx / a load balancer (Phase 12)
TRUST_PROXY=false

# ── Data (used from Phase 1) — local Docker infra, see `npm run infra:up`
MONGODB_URI=mongodb://127.0.0.1:27018/cell_ai_voicebot?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6380
# Run BullMQ workers in this process (Phase 12 may run them in a separate worker process)
WORKERS_ENABLED=true

# ── Auth & security (used from Phase 2)
# SECRET — kabhi commit nahi
JWT_ACCESS_SECRET=change-me
# SECRET — kabhi commit nahi
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# SECRET — kabhi commit nahi (32 random bytes, base64 — used to encrypt PII at rest)
ENCRYPTION_KEY=change-me-32-bytes-base64

# ── AI (used from Phase 5 / 7)
# SECRET — kabhi commit nahi
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# ── Storage (used from Phase 7 / 9) — STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
# SECRET — kabhi commit nahi
AWS_ACCESS_KEY_ID=
# SECRET — kabhi commit nahi
AWS_SECRET_ACCESS_KEY=

# ── Email (Phase 1 — T1.13; ADR 0030)
# smtp | log — default: smtp when SMTP_HOST is set, else log (emails are only logged).
# Production requires smtp. Local dev: Mailpit from `npm run infra:up` → SMTP_HOST=127.0.0.1, SMTP_PORT=1025
EMAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); empty = auto (true only when SMTP_PORT=465)
SMTP_SECURE=
# SMTP_USER and SMTP_PASS must be set together (or both empty)
SMTP_USER=
# SECRET — kabhi commit nahi
SMTP_PASS=
MAIL_FROM="Cell AI Voicebot <no-reply@example.com>"

# ── Payments (used from Phase 4)
RAZORPAY_KEY_ID=
# SECRET — kabhi commit nahi
RAZORPAY_KEY_SECRET=
# SECRET — kabhi commit nahi
RAZORPAY_WEBHOOK_SECRET=

# ── Telephony (Phase 13 / optional NotifyNow fallback)
# SECRET — kabhi commit nahi
NOTIFYNOW_API_KEY=
SIP_HOST=
SIP_PORT=5060
SIP_TRANSPORT=udp
SIP_USERNAME=
# SECRET — kabhi commit nahi
SIP_PASSWORD=
SIP_CALLER_ID=

# ── Tooling (scripts only, not the API)
# Absolute path to the client server SSH key used by `npm run server:audit` (path only — the key itself stays outside the repo)
CLIENT_SSH_KEY_PATH=
