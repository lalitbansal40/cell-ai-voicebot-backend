# Copy to /srv/cell-ai-voicebot/env/ops.env, chmod 600.
# Use an instance role, ~/.aws credentials, or env/aws.credentials (0600) for AWS CLI.
BACKUP_TARGET=s3://<bucket>/prod/
ALERT_EMAIL=
# The repo release.sh pulls tags from. Private repo: use a read-only deploy key.
RELEASE_REPO_URL=https://github.com/Cell24x7/cell-ai-voicebot.git
