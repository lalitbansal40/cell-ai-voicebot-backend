; Rendered by render.sh at container start (ADR 0050). Lines left empty after rendering are dropped.
[global]
type=global
user_agent=cav
endpoint_identifier_order=ip,username

[transport-udp]
type=transport
protocol=udp
bind=${SIP_BIND}:${SIP_LISTEN_PORT}
external_media_address=${SIP_EXTERNAL_ADDRESS}
external_signaling_address=${SIP_EXTERNAL_ADDRESS}
local_net=${SIP_LOCAL_NET}

[transport-tcp]
type=transport
protocol=tcp
bind=${SIP_BIND}:${SIP_LISTEN_PORT}
external_media_address=${SIP_EXTERNAL_ADDRESS}
external_signaling_address=${SIP_EXTERNAL_ADDRESS}
local_net=${SIP_LOCAL_NET}

; The server-wide trunk (only when SIP_HOST is set in asterisk.env). Accounts can also have
; their own trunk, added at run time over ARI (sorcery memory, see sorcery.conf).
#include pjsip_trunk.conf
