# Cell AI Voicebot — STAGING backend env (Phase 13). Template only — NO real values here.
# The owner copies it to ~/.cav-staging/backend.env (chmod 600) on the Mac and fills the
# secrets from the password manager; the run copies it to the server as
# /srv/cell-ai-voicebot/env/backend.env (chmod 600, owner cav). Never paste secrets into
# a chat, a ticket or git. <app-host> = the app hostname (e.g. app.<client-domain>).

# ── App
NODE_ENV=production
HOST=127.0.0.1
PORT=5100
APP_URL=https://<app-host>
FRONTEND_URL=https://<app-host>
CORS_ORIGINS=https://<app-host>
TRUST_PROXY=1
API_DOCS_ENABLED=false
LOG_LEVEL=info
AUTH_COOKIE_DOMAIN=
AUTH_RATE_LIMIT_MAX=30

# ── Data — the passwords are written by the server-side setup (deploy/staging/scripts/
# init-secrets.sh) from compose.env; leave <secret> here, the script replaces it
MONGODB_URI=mongodb://cav:<secret>@127.0.0.1:27018/cell_ai_voicebot?replicaSet=rs0&authSource=admin
REDIS_URL=redis://:<secret>@127.0.0.1:6380
# WORKERS_ENABLED is set per container by compose.yaml (api false, worker true)

# ── Auth & encryption (SECRET — generated once: openssl rand -base64 48 / 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# 32 random bytes, base64 (openssl rand -base64 32) — losing it makes sealed tokens unreadable
ENCRYPTION_KEY=

# ── AI (SECRET key: a separate OpenAI project for staging with a monthly budget cap)
OPENAI_API_KEY=
AI_PROVIDER=openai
VOICE_PROVIDER=openai
MOCK_APIS_ENABLED=false
AI_FUNCTIONS_ALLOW_PRIVATE_HOSTS=false
VOICE_TEXT_INPUT_ENABLED=false

# ── Calls / campaigns
TELEPHONY_PROVIDER=dryrun
CALL_RETENTION_DAYS=180
CALL_RECORDING_TMP_DIR=/srv/cell-ai-voicebot/uploads/tmp-rec
DRY_RUN_MAX_SPEED=20
CAMPAIGNS_ENABLED=true

# ── WhatsApp / Meta — filled at GATE B (leave META_* empty until then: WhatsApp stays off)
WHATSAPP_ENABLED=
META_PROVIDER=meta
META_APP_ID=
# SECRET
META_APP_SECRET=
META_ES_CONFIG_ID=
# SECRET — a new random string, at least 24 characters
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# "customer pays Meta" at launch (plan §7 #4): leave both empty
META_CREDIT_LINE_ID=
META_SYSTEM_USER_TOKEN=
INBOX_RETENTION_DAYS=90

# ── WhatsApp calling media (UDP 40000–40999 open in the security group + ufw)
WA_MEDIA_ENABLED=true
WA_MEDIA_PUBLIC_IP=<elastic ip>
WA_MEDIA_PORT_MIN=40000
WA_MEDIA_PORT_MAX=40999
WA_STUN_URLS=stun:stun.l.google.com:19302
WA_MEDIA_MAX_CALLS=50

# ── Storage (local volume, backed up nightly — S3 in Phase 17)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/srv/cell-ai-voicebot/uploads

# ── E-mail (SMTP of the sender domain with SPF / DKIM / DMARC)
EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
# SECRET
SMTP_PASS=
MAIL_FROM="Cell AI Voicebot <no-reply@<domain>>"

# ── Payments (Razorpay TEST mode on staging: rzp_test_… keys)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# SECRET
RAZORPAY_WEBHOOK_SECRET=
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
BILLING_SELLER_STATE_CODE=
BILLING_SAC_CODE=998319
BILLING_INVOICE_PREFIX=STG
BILLING_SIMULATOR_ENABLED=false
