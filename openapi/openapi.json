{
  "openapi": "3.1.0",
  "info": {
    "title": "Cell AI Voicebot API",
    "version": "0.0.1",
    "description": "Multi-tenant AI voice calling platform API. Conventions: docs/conventions/api.md."
  },
  "servers": [{ "url": "http://localhost:5100", "description": "Local development" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Dashboard access token (ADR 0009)."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Public API key with scopes (Phase 10)."
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "example": "phone" },
          "message": { "type": "string", "example": "Must be an E.164 number" }
        },
        "required": ["path", "message"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_FAILED" },
              "message": { "type": "string", "example": "Some fields are invalid." },
              "details": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ErrorDetail" }
              },
              "requestId": { "type": "string", "example": "req_8f2c1a" }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["success", "error"]
      },
      "OffsetPageMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        },
        "required": ["page", "limit", "total", "totalPages"]
      },
      "CursorPageMeta": {
        "type": "object",
        "properties": {
          "nextCursor": { "type": ["string", "null"] },
          "hasMore": { "type": "boolean" }
        },
        "required": ["nextCursor", "hasMore"]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Session (refresh family) id" },
          "userAgent": { "type": ["string", "null"] },
          "ip": { "type": ["string", "null"] },
          "createdAt": { "type": "string" },
          "lastUsedAt": { "type": "string" },
          "current": { "type": "boolean" }
        },
        "required": ["id", "userAgent", "ip", "createdAt", "lastUsedAt", "current"]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Check your email for a verification code." }
        },
        "required": ["message"]
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["invited", "active", "disabled"] },
          "emailVerifiedAt": { "type": ["string", "null"] },
          "lastLoginAt": { "type": ["string", "null"] },
          "platformRole": { "type": ["string", "null"], "enum": ["superadmin", null] },
          "createdAt": { "type": "string" }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "status",
          "emailVerifiedAt",
          "lastLoginAt",
          "platformRole",
          "createdAt"
        ]
      },
      "PublicAccount": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "suspended"] },
          "suspendReason": { "type": ["string", "null"] },
          "ownerId": { "type": ["string", "null"] },
          "isPlatform": { "type": "boolean" },
          "timezone": { "type": "string" },
          "country": { "type": "string" },
          "defaultLanguage": { "type": "string", "enum": ["hi", "en", "hinglish"] },
          "settings": {
            "type": "object",
            "properties": {
              "callingWindow": {
                "type": "object",
                "properties": {
                  "start": { "type": "string", "example": "09:00" },
                  "end": { "type": "string", "example": "19:00" },
                  "days": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0, "maximum": 6 },
                    "example": [1, 2, 3, 4, 5, 6]
                  }
                },
                "required": ["start", "end", "days"]
              },
              "recordingEnabled": { "type": "boolean" },
              "aiDisclosureEnabled": { "type": "boolean" }
            },
            "required": ["callingWindow", "recordingEnabled", "aiDisclosureEnabled"]
          },
          "createdAt": { "type": "string" }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "suspendReason",
          "ownerId",
          "isPlatform",
          "timezone",
          "country",
          "defaultLanguage",
          "settings",
          "createdAt"
        ]
      },
      "AuthMe": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/PublicUser" },
          "account": { "$ref": "#/components/schemas/PublicAccount" },
          "role": {
            "type": "object",
            "properties": { "key": { "type": "string" }, "name": { "type": "string" } },
            "required": ["key", "name"]
          },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "impersonation": {
            "type": ["object", "null"],
            "properties": {
              "impersonatorId": { "type": "string" },
              "expiresAt": { "type": "string" }
            },
            "required": ["impersonatorId", "expiresAt"]
          }
        },
        "required": ["user", "account", "role", "permissions", "impersonation"]
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "expiresIn": { "type": "integer", "example": 900 },
          "user": { "$ref": "#/components/schemas/PublicUser" },
          "account": { "$ref": "#/components/schemas/PublicAccount" },
          "role": {
            "type": "object",
            "properties": { "key": { "type": "string" }, "name": { "type": "string" } },
            "required": ["key", "name"]
          },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "impersonation": {
            "type": ["object", "null"],
            "properties": {
              "impersonatorId": { "type": "string" },
              "expiresAt": { "type": "string" }
            },
            "required": ["impersonatorId", "expiresAt"]
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user",
          "account",
          "role",
          "permissions",
          "impersonation"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "uptimeSec": { "type": "integer", "minimum": 0, "example": 3600 }
        },
        "required": ["status", "uptimeSec"]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ready"] },
          "checks": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["up"] },
            "example": { "mongo": "up", "redis": "up" }
          }
        },
        "required": ["status", "checks"]
      },
      "RbacCatalog": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "example": "team.invite" },
                "group": { "type": "string", "example": "Team" },
                "description": { "type": "string" }
              },
              "required": ["key", "group", "description"]
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": ["owner", "admin", "manager", "agent", "viewer"]
                },
                "name": { "type": "string" },
                "permissions": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["key", "name", "permissions"]
            }
          }
        },
        "required": ["permissions", "roles"]
      },
      "AppInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "cell-ai-voicebot-backend" },
          "version": { "type": "string", "example": "0.0.1" },
          "node": { "type": "string", "example": "v24.19.0" },
          "env": { "type": "string", "example": "development" }
        },
        "required": ["name", "version", "node", "env"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create an account + owner; sends a 6-digit email code (always 202)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80,
                    "example": "Demo Finance"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "example": "Asha Verma"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "asha@example.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "format": "password"
                  },
                  "phone": { "type": "string" },
                  "timezone": { "type": "string", "example": "Asia/Kolkata" }
                },
                "required": ["businessName", "name", "email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Accepted" } }
            }
          },
          "422": {
            "description": "Validation failed / invalid code (VALIDATION_FAILED, AUTH_CODE_INVALID)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "429": {
            "description": "Rate limited / too many attempts (RATE_LIMITED, AUTH_TOO_MANY_ATTEMPTS) — see Retry-After",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirm the email code and sign in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "asha@example.com"
                  },
                  "code": { "type": "string", "pattern": "^\\d{6}$", "example": "042917" }
                },
                "required": ["email", "code"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Sets the httpOnly `cav_rt` refresh cookie (Path=/api/v1/auth, SameSite=Strict).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/AuthSession" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "422": {
            "description": "Validation failed / invalid code (VALIDATION_FAILED, AUTH_CODE_INVALID)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "429": {
            "description": "Rate limited / too many attempts (RATE_LIMITED, AUTH_TOO_MANY_ATTEMPTS) — see Retry-After",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in with email + password (5 failures in 15 min → 429)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "asha@example.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "format": "password"
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in. Sets the httpOnly `cav_rt` refresh cookie (Path=/api/v1/auth, SameSite=Strict).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/AuthSession" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "403": {
            "description": "Missing permission, disabled user, suspended account or impersonation block",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "422": {
            "description": "Validation failed / invalid code (VALIDATION_FAILED, AUTH_CODE_INVALID)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "429": {
            "description": "Rate limited / too many attempts (RATE_LIMITED, AUTH_TOO_MANY_ATTEMPTS) — see Retry-After",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "New access token from the refresh cookie (rotates the cookie; reuse revokes the session)",
        "responses": {
          "200": {
            "description": "Signed in. Sets the httpOnly `cav_rt` refresh cookie (Path=/api/v1/auth, SameSite=Strict).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/AuthSession" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "403": {
            "description": "Missing permission, disabled user, suspended account or impersonation block",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "End the cookie session (idempotent, clears the cookie)",
        "responses": { "204": { "description": "No content" } }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign out of every session (all access tokens stop working)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "No content" },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "403": {
            "description": "Missing permission, disabled user, suspended account or impersonation block",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current user, account, role, permissions and impersonation info",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/AuthMe" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "tags": ["Auth"],
        "summary": "Active sessions of the current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Session" } }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}": {
      "delete": {
        "tags": ["Auth"],
        "summary": "Revoke one of your sessions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "schema": { "type": "string", "minLength": 8, "maxLength": 64 },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": { "description": "No content" },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "404": {
            "description": "Not found in this account (RESOURCE_NOT_FOUND)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email/resend": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send a new email code (always 202; 60 s cooldown, 5 per hour)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "example": "asha@example.com"
                  }
                },
                "required": ["email"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Accepted" } }
            }
          },
          "422": {
            "description": "Validation failed / invalid code (VALIDATION_FAILED, AUTH_CODE_INVALID)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "429": {
            "description": "Rate limited / too many attempts (RATE_LIMITED, AUTH_TOO_MANY_ATTEMPTS) — see Retry-After",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness — the process is up (no dependency checks)",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/Health" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["System"],
        "summary": "Readiness — MongoDB and Redis reachable and not shutting down",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/Readiness" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down or the server is shutting down (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/rbac/permissions": {
      "get": {
        "tags": ["RBAC"],
        "summary": "Permission catalogue and built-in roles",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/RbacCatalog" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "401": {
            "description": "Missing / invalid / expired token (AUTH_UNAUTHENTICATED, AUTH_TOKEN_EXPIRED)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": ["System"],
        "summary": "Service name, version and runtime",
        "responses": {
          "200": {
            "description": "App info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "data": { "$ref": "#/components/schemas/AppInfo" }
                  },
                  "required": ["success", "data"]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
