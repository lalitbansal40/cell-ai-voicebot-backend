{
  "name": "cell-ai-voicebot-backend",
  "version": "0.0.1",
  "description": "Cell AI Voicebot — multi-tenant AI voice calling platform API",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f --tail=100",
    "infra:ps": "docker compose ps",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run gen:openapi && git diff --exit-code -- openapi/openapi.json",
    "server:audit": "bash scripts/run-server-audit.sh",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts up",
    "db:migrate:down": "tsx --env-file-if-exists=.env scripts/db-migrate.ts down",
    "db:migrate:status": "tsx --env-file-if-exists=.env scripts/db-migrate.ts status",
    "db:sync-indexes": "tsx --env-file-if-exists=.env scripts/db-sync-indexes.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": true,
    "mongodb-memory-server": false
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.12"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.14",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  }
}
