{
  "name": "cell-ai-voicebot-backend",
  "version": "0.0.1",
  "description": "Cell AI Voicebot — multi-tenant AI voice calling platform API",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
