{
  "name": "cell-ai-voicebot-backend",
  "version": "0.0.1",
  "description": "Cell AI Voicebot \u2014 multi-tenant AI voice calling platform API",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f --tail=100",
    "infra:ps": "docker compose ps",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run gen:openapi && git diff --exit-code -- openapi/openapi.json",
    "server:audit": "bash scripts/run-server-audit.sh",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts up",
    "db:migrate:down": "tsx --env-file-if-exists=.env scripts/db-migrate.ts down",
    "db:migrate:status": "tsx --env-file-if-exists=.env scripts/db-migrate.ts status",
    "db:sync-indexes": "tsx --env-file-if-exists=.env scripts/db-sync-indexes.ts",
    "ws:dev-ticket": "tsx --env-file-if-exists=.env scripts/ws-dev-ticket.ts",
    "email:test": "tsx --env-file-if-exists=.env scripts/email-test.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "superadmin:create": "tsx --env-file-if-exists=.env scripts/superadmin-create.ts",
    "samples:contacts": "tsx scripts/make-contact-samples.ts",
    "bench:contacts": "tsx --env-file-if-exists=.env scripts/bench-contacts.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.18",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "write-excel-file": "^4.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "unrs-resolver": true,
    "mongodb-memory-server": false,
    "msgpackr-extract": false,
    "@scarf/scarf": false
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.12"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "read-excel-file": "^9.3.12",
    "swagger-ui-dist": "^5.33.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
